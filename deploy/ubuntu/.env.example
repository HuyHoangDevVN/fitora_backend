GATEWAY_PORT=8081
FRONTEND_PORT=8082
JWT_SECRET=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MONGO_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
ELASTIC_PASSWORD=CHANGE_ME
